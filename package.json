{
  "name": "tos-risk-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sözleşme sayfalarını LLM ile analiz eden ama LLM'e güvenmeyen Chrome uzantısı",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:secrets": "vitest run tests/unit/secrets.test.ts",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "eval": "tsx eval/run-eval.ts",
    "label": "tsx scripts/build-label-tool.ts",
    "build:e2e": "vite build --mode e2e",
    "e2e": "node scripts/e2e.mjs run",
    "e2e:open": "node scripts/e2e.mjs open",
    "e2e:video": "node scripts/e2e.mjs video"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@puppeteer/browsers": "^3.2.4",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "cypress": "^16.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@page-agent/page-controller": "^1.12.4",
    "zod": "^4.6.5"
  }
}
